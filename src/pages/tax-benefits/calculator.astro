---
import Layout from '../../../layouts/Page.astro';
import '../../../styles/oz-custom.css';

const seo = {
	title: 'Opportunity Zone Tax Benefits Calculator | OZ Investment Tax Savings',
	description: 'Calculate your potential tax savings with our comprehensive Opportunity Zone tax benefits calculator. See deferral, reduction, and elimination benefits.',
};
---

<Layout {seo}>
	<!-- Hero Section -->
	<section class="oz-hero">
		<div class="oz-hero-content">
			<h1>Opportunity Zone Tax Benefits Calculator</h1>
			<p class="subtitle">Calculate your potential tax savings from Opportunity Zone investments</p>
		</div>
	</section>

	<!-- Calculator Section -->
	<section class="oz-services">
		<div class="oz-services-content">
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 2rem;">
				<!-- Calculator Inputs -->
				<div>
					<h2>Investment Parameters</h2>
					<form class="oz-form" id="tax-calculator-form">
						<div class="oz-form-group">
							<label class="oz-form-label" for="capital-gains">Capital Gains Amount ($)</label>
							<input type="number" id="capital-gains" name="capital-gains" class="oz-form-input" placeholder="1000000" required>
						</div>
						
						<div class="oz-form-group">
							<label class="oz-form-label" for="cap-gains-rate">Capital Gains Tax Rate (%)</label>
							<input type="number" id="cap-gains-rate" name="cap-gains-rate" class="oz-form-input" placeholder="20" value="20" required>
						</div>
						
						<div class="oz-form-group">
							<label class="oz-form-label" for="hold-period">Hold Period (Years)</label>
							<select id="hold-period" name="hold-period" class="oz-form-input" required>
								<option value="5">5 Years (10% Basis Step-up)</option>
								<option value="7">7 Years (15% Basis Step-up)</option>
								<option value="10" selected>10 Years (Tax-free Appreciation)</option>
							</select>
						</div>
						
						<div class="oz-form-group">
							<label class="oz-form-label" for="annual-return">Expected Annual Return (%)</label>
							<input type="number" id="annual-return" name="annual-return" class="oz-form-input" placeholder="8" value="8" step="0.1" required>
						</div>
						
						<div class="oz-form-group">
							<label class="oz-form-label" for="investment-date">Investment Date</label>
							<input type="date" id="investment-date" name="investment-date" class="oz-form-input" required>
						</div>
						
						<button type="submit" class="oz-btn oz-btn-primary" style="width: 100%;">Calculate Tax Benefits</button>
					</form>
				</div>
				
				<!-- Calculator Results -->
				<div>
					<h2>Tax Benefits Analysis</h2>
					<div id="calculator-results" style="display: none;">
						<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
							<h3>Immediate Benefits</h3>
							<div class="benefit-item">
								<span class="benefit-label">Tax Deferral Amount:</span>
								<span class="benefit-value" id="deferral-amount">$0</span>
							</div>
							<div class="benefit-item">
								<span class="benefit-label">Deferral Period:</span>
								<span class="benefit-value" id="deferral-period">0 years</span>
							</div>
							
							<h3>Basis Step-up Benefits</h3>
							<div class="benefit-item">
								<span class="benefit-label">Basis Step-up %:</span>
								<span class="benefit-value" id="basis-stepup">0%</span>
							</div>
							<div class="benefit-item">
								<span class="benefit-label">Reduced Taxable Amount:</span>
								<span class="benefit-value" id="reduced-taxable">$0</span>
							</div>
							
							<h3>Long-term Benefits (10+ Years)</h3>
							<div class="benefit-item">
								<span class="benefit-label">Total Investment Value:</span>
								<span class="benefit-value" id="total-value">$0</span>
							</div>
							<div class="benefit-item">
								<span class="benefit-label">Appreciation Amount:</span>
								<span class="benefit-value" id="appreciation">$0</span>
							</div>
							<div class="benefit-item">
								<span class="benefit-label">Tax-free Appreciation:</span>
								<span class="benefit-value" id="tax-free-appreciation">$0</span>
							</div>
							
							<h3>Total Tax Savings</h3>
							<div class="benefit-item total-savings">
								<span class="benefit-label">Total Tax Savings:</span>
								<span class="benefit-value" id="total-savings">$0</span>
							</div>
						</div>
					</div>
					
					<div id="calculator-placeholder" style="background: var(--oz-gray-50); padding: 2rem; border-radius: 0.5rem; text-align: center; color: var(--oz-gray-600);">
						<p>Enter your investment parameters to see your potential tax savings</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Tax Benefits Explanation -->
	<section class="oz-authority">
		<div class="oz-authority-content">
			<h2>Understanding Opportunity Zone Tax Benefits</h2>
			<div class="oz-authority-grid">
				<div class="oz-authority-card">
					<h3>1. Capital Gains Deferral</h3>
					<p>Defer paying taxes on capital gains until December 31, 2026, or when you sell your OZ investment, whichever comes first. This provides immediate liquidity relief and time value of money benefits.</p>
				</div>
				<div class="oz-authority-card">
					<h3>2. Basis Step-up</h3>
					<p>Reduce your deferred capital gains by 10% after 5 years and an additional 5% after 7 years, for a total 15% reduction on the original deferred gains.</p>
				</div>
				<div class="oz-authority-card">
					<h3>3. Tax-free Appreciation</h3>
					<p>If you hold your OZ investment for at least 10 years, any appreciation above your original investment is completely tax-free when you sell.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Important Disclaimers -->
	<section class="oz-testimonials">
		<div class="oz-testimonials-content">
			<h2>Important Disclaimers</h2>
			<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow); max-width: 800px; margin: 0 auto;">
				<p><strong>Tax Advice Disclaimer:</strong> This calculator is for educational purposes only and does not constitute tax, legal, or investment advice. Tax laws are complex and subject to change. Consult with qualified tax and legal professionals before making any investment decisions.</p>
				<p><strong>Investment Risk:</strong> All investments carry risk, including the potential loss of principal. Past performance does not guarantee future results. Opportunity Zone investments are subject to specific regulatory requirements and may not be suitable for all investors.</p>
				<p><strong>Accredited Investor Requirement:</strong> Most Opportunity Zone investments are available only to accredited investors as defined by the SEC.</p>
			</div>
		</div>
	</section>
</Layout>

<script>
	document.getElementById('investment-date').valueAsDate = new Date();
	
	document.getElementById('tax-calculator-form').addEventListener('submit', function(e) {
		e.preventDefault();
		calculateTaxBenefits();
	});
	
	function calculateTaxBenefits() {
		const capitalGains = parseFloat(document.getElementById('capital-gains').value) || 0;
		const capGainsRate = parseFloat(document.getElementById('cap-gains-rate').value) || 0;
		const holdPeriod = parseInt(document.getElementById('hold-period').value) || 10;
		const annualReturn = parseFloat(document.getElementById('annual-return').value) || 0;
		const investmentDate = new Date(document.getElementById('investment-date').value);
		
		if (!capitalGains || !capGainsRate || !annualReturn) {
			alert('Please fill in all required fields');
			return;
		}
		
		// Calculate immediate tax deferral
		const immediateTax = capitalGains * (capGainsRate / 100);
		const deferralEndDate = new Date('2026-12-31');
		const deferralYears = Math.max(0, (deferralEndDate - investmentDate) / (365.25 * 24 * 60 * 60 * 1000));
		
		// Calculate basis step-up
		let basisStepup = 0;
		if (holdPeriod >= 7) {
			basisStepup = 15;
		} else if (holdPeriod >= 5) {
			basisStepup = 10;
		}
		
		const reducedTaxableAmount = capitalGains * (basisStepup / 100);
		const basisStepupTaxSavings = reducedTaxableAmount * (capGainsRate / 100);
		
		// Calculate long-term appreciation
		const totalValue = capitalGains * Math.pow(1 + (annualReturn / 100), holdPeriod);
		const appreciation = totalValue - capitalGains;
		
		// Tax-free appreciation (only if held 10+ years)
		const taxFreeAppreciation = holdPeriod >= 10 ? appreciation : 0;
		const taxFreeAppreciationSavings = taxFreeAppreciation * (capGainsRate / 100);
		
		// Total tax savings
		const totalSavings = immediateTax + basisStepupTaxSavings + taxFreeAppreciationSavings;
		
		// Display results
		document.getElementById('deferral-amount').textContent = '$' + immediateTax.toLocaleString();
		document.getElementById('deferral-period').textContent = deferralYears.toFixed(1) + ' years';
		document.getElementById('basis-stepup').textContent = basisStepup + '%';
		document.getElementById('reduced-taxable').textContent = '$' + reducedTaxableAmount.toLocaleString();
		document.getElementById('total-value').textContent = '$' + totalValue.toLocaleString();
		document.getElementById('appreciation').textContent = '$' + appreciation.toLocaleString();
		document.getElementById('tax-free-appreciation').textContent = '$' + taxFreeAppreciation.toLocaleString();
		document.getElementById('total-savings').textContent = '$' + totalSavings.toLocaleString();
		
		// Show results
		document.getElementById('calculator-results').style.display = 'block';
		document.getElementById('calculator-placeholder').style.display = 'none';
	}
</script>

<style>
	.benefit-item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--oz-gray-200);
	}
	
	.benefit-item:last-child {
		border-bottom: none;
	}
	
	.benefit-label {
		font-weight: 500;
		color: var(--oz-gray-700);
	}
	
	.benefit-value {
		font-weight: 700;
		color: var(--oz-navy);
		font-size: 1.125rem;
	}
	
	.total-savings {
		background: var(--oz-gold);
		color: var(--oz-white);
		padding: 1rem;
		border-radius: 0.375rem;
		margin-top: 1rem;
	}
	
	.total-savings .benefit-label,
	.total-savings .benefit-value {
		color: var(--oz-white);
		font-size: 1.25rem;
	}
	
	@media (max-width: 768px) {
		.oz-services-content > div {
			grid-template-columns: 1fr;
		}
	}
</style>
