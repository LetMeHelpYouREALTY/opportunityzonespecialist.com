								<li>Estate planning benefits</li>
							</ul>
							<div class="bg-green-50 border-l-4 border-green-400 p-4">
								<p class="text-green-800 font-semibold">
									<strong>Total Tax Savings:</strong> $1.7M+ over 10 years
								</p>
							</div>
						</div>
						<div class="bg-gray-100 p-6 rounded-lg">
							<h4 class="text-xl font-semibold text-navy-700 mb-4">Investment Details</h4>
							<div class="space-y-3">
								<div class="flex justify-between">
									<span class="text-gray-600">Investment Amount:</span>
									<span class="font-semibold">$3.2M</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600">Property Type:</span>
									<span class="font-semibold">Mixed-Use Development</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600">Location:</span>
									<span class="font-semibold">Summerlin, NV</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600">Timeline:</span>
									<span class="font-semibold">3 years</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600">Appreciation:</span>
									<span class="font-semibold text-green-600">52%</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Results Summary -->
		<section class="py-16 bg-navy-700 text-white">
			<div class="container mx-auto px-4 text-center">
				<h2 class="text-4xl font-bold mb-8">Proven Results Across All Client Types</h2>
				<div class="grid md:grid-cols-4 gap-8 mb-12">
					<div class="text-center">
						<div class="text-4xl font-bold text-gold-400 mb-2">$11.4M</div>
						<div class="text-lg">Total Capital Gains Deferred</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-gold-400 mb-2">$5.95M</div>
						<div class="text-lg">Total Tax Savings</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-gold-400 mb-2">44%</div>
						<div class="text-lg">Average Appreciation</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-gold-400 mb-2">100%</div>
						<div class="text-lg">Client Satisfaction</div>
					</div>
				</div>
				<p class="text-xl mb-8">
