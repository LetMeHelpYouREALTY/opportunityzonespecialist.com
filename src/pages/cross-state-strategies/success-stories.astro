					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-16 bg-white">
			<div class="container mx-auto px-4 text-center">
				<h2 class="text-4xl font-bold text-navy-800 mb-6">Ready to Create Your Success Story?</h2>
				<p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto">
					Join our successful clients who have optimized their capital gains through strategic cross-state Opportunity Zone investments. Let the Boyle-Duffy team help you achieve similar results.
