---
import Layout from '../../../layouts/Page.astro';
import '../../../styles/oz-custom.css';

const seo = {
	title: 'Dr. Jan Duffy - Nevada OZ Expert | 500+ Transactions | Las Vegas Opportunity Zone Specialist',
	description: 'Dr. Jan Duffy is Nevada\'s premier Opportunity Zone expert with 500+ transactions completed. Specializing in cross-state OZ strategies for California high-net-worth clients. Call/Text: 702-222-1964',
};
---

<Layout {seo}>
	<!-- Hero Section -->
	<section class="oz-hero">
		<div class="oz-hero-content">
			<h1>Dr. Jan Duffy - Nevada OZ Expert</h1>
			<p class="subtitle">500+ transactions completed • Cross-state OZ strategy specialist • Nevada tax advantage expert</p>
			<div class="oz-hero-cta">
				<a href="tel:702-222-1964" class="oz-btn oz-btn-primary">Call/Text Dr. Jan: 702-222-1964</a>
				<a href="/cross-state-strategies/tax-savings-calculator" class="oz-btn oz-btn-secondary">Calculate Your Savings</a>
			</div>
		</div>
	</section>

	<!-- Expert Profile -->
	<section class="oz-services">
		<div class="oz-services-content">
			<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; margin-top: 2rem;">
				<!-- Expert Photo & Contact -->
				<div>
					<div style="text-align: center; margin-bottom: 2rem;">
						<div style="width: 8rem; height: 8rem; background: var(--oz-gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 3rem;">👩‍🎓</div>
						<h2>Dr. Jan Duffy</h2>
						<h3 style="color: var(--oz-gold); margin: 0;">Nevada OZ Expert</h3>
					</div>
					
					<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
						<h3>Direct Contact</h3>
						<p><strong>Phone/Text:</strong> <a href="tel:702-222-1964" style="color: var(--oz-gold); font-weight: 600;">702-222-1964</a></p>
						<p><strong>Email:</strong> <a href="mailto:drjan@boyle-duffy-oz.com" style="color: var(--oz-gold);">drjan@boyle-duffy-oz.com</a></p>
						<p><strong>Territory:</strong> Nevada (Las Vegas, Henderson, Summerlin, Reno)</p>
						
						<h3>Specializations</h3>
						<ul style="text-align: left;">
							<li>Cross-state OZ strategies</li>
							<li>California → Nevada tax optimization</li>
							<li>High-net-worth client focus</li>
							<li>Commercial OZ development</li>
							<li>Residential OZ communities</li>
						</ul>
					</div>
				</div>
				
				<!-- Expert Bio & Achievements -->
				<div>
					<h2>Nevada's Premier OZ Expert</h2>
					<p style="font-size: 1.125rem; color: var(--oz-gray-600); margin-bottom: 2rem;">
						Dr. Jan Duffy has completed over 500 Opportunity Zone transactions, making her Nevada's most experienced OZ expert. Her unique cross-state strategy approach helps California high-net-worth clients maximize tax benefits while investing in Nevada's growing OZ markets.
					</p>
					
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
						<div style="background: var(--oz-white); padding: 1.5rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow); text-align: center;">
							<div style="font-size: 2rem; font-weight: 700; color: var(--oz-gold);">500+</div>
							<div style="color: var(--oz-gray-700);">Transactions Completed</div>
						</div>
						<div style="background: var(--oz-white); padding: 1.5rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow); text-align: center;">
							<div style="font-size: 2rem; font-weight: 700; color: var(--oz-gold);">$2B+</div>
							<div style="color: var(--oz-gray-700);">Capital Deployed</div>
						</div>
						<div style="background: var(--oz-white); padding: 1.5rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow); text-align: center;">
							<div style="font-size: 2rem; font-weight: 700; color: var(--oz-gold);">15+</div>
							<div style="color: var(--oz-gray-700);">Years Experience</div>
						</div>
					</div>
					
					<h3>Cross-State Strategy Expertise</h3>
					<p>Dr. Jan specializes in helping California clients optimize their capital gains through Nevada OZ investments. Her approach combines:</p>
					<ul style="text-align: left; margin: 1rem 0;">
						<li><strong>California Capital Gains Elimination:</strong> Nevada's no state income tax advantage</li>
						<li><strong>Federal OZ Benefits:</strong> Deferral, basis step-up, and tax-free appreciation</li>
						<li><strong>Market Expertise:</strong> Deep knowledge of Las Vegas, Henderson, and Reno OZ markets</li>
						<li><strong>High-Net-Worth Focus:</strong> Specialized strategies for $1M+ investments</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Nevada Markets -->
	<section class="oz-authority">
		<div class="oz-authority-content">
			<h2>Dr. Jan's Nevada OZ Markets</h2>
			<div class="oz-authority-grid">
				<div class="oz-authority-card">
					<h3>Las Vegas OZ Properties 🎰</h3>
					<p>Prime Las Vegas Opportunity Zone properties including tech campuses, mixed-use developments, and commercial real estate. Perfect for California capital gains optimization.</p>
					<a href="/dr-jan-duffy/las-vegas-oz-properties" class="oz-btn oz-btn-outline">View Las Vegas OZs</a>
				</div>
				<div class="oz-authority-card">
					<h3>Henderson Development</h3>
					<p>Henderson's growing OZ market offers excellent opportunities for residential and commercial development. Strong demographics and infrastructure make it ideal for long-term appreciation.</p>
					<a href="/dr-jan-duffy/henderson-development" class="oz-btn oz-btn-outline">View Henderson OZs</a>
				</div>
				<div class="oz-authority-card">
					<h3>Summerlin OZ Opportunities</h3>
					<p>Summerlin's master-planned community OZ properties offer premium residential and commercial opportunities. High-end demographics and planned growth create strong investment potential.</p>
					<a href="/dr-jan-duffy/summerlin-oz-opportunities" class="oz-btn oz-btn-outline">View Summerlin OZs</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Client Success Stories -->
	<section class="oz-testimonials">
		<div class="oz-testimonials-content">
			<h2>Dr. Jan's Cross-State Success Stories</h2>
			<div class="oz-testimonials-grid">
				<div class="oz-testimonial-card">
					<div class="testimonial-content">
						<p>"Dr. Jan's Nevada expertise saved me over $400K in California state taxes on my tech stock gains. Her cross-state strategy was exactly what I needed."</p>
					</div>
					<div class="testimonial-author">
						<h4>Sarah Chen</h4>
						<span>Tech Executive, Palo Alto</span>
						<span style="color: var(--oz-gold); font-weight: 600;">$3.2M Investment</span>
					</div>
				</div>
				
				<div class="oz-testimonial-card">
					<div class="testimonial-content">
						<p>"Working with Dr. Jan and the Boyle brothers created the perfect cross-state OZ strategy. The tax savings exceeded our projections by 20%."</p>
					</div>
					<div class="testimonial-author">
						<h4>Michael Rodriguez</h4>
						<span>Entertainment Producer, Beverly Hills</span>
						<span style="color: var(--oz-gold); font-weight: 600;">$1.8M Investment</span>
					</div>
				</div>
				
				<div class="oz-testimonial-card">
					<div class="testimonial-content">
						<p>"Dr. Jan's 500+ transaction experience showed in every aspect of our Nevada OZ investment. Professional, knowledgeable, and results-driven."</p>
					</div>
					<div class="testimonial-author">
						<h4>Jennifer Walsh</h4>
						<span>Family Office Director, San Francisco</span>
						<span style="color: var(--oz-gold); font-weight: 600;">$5.1M Investment</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Current Nevada Opportunities -->
	<section class="oz-authority">
		<div class="oz-authority-content">
			<h2>Dr. Jan's Current Nevada OZ Opportunities</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem;">
				<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
					<h3>Las Vegas Tech Campus OZ</h3>
					<p><strong>Location:</strong> Las Vegas, NV - Census Tract 32.01</p>
					<p><strong>Investment:</strong> $1M - $5M</p>
					<p><strong>Expected IRR:</strong> 16-20%</p>
					<p><strong>Tax Benefit:</strong> Eliminates CA state capital gains tax</p>
					<p><strong>Status:</strong> 75% Funded</p>
					<a href="tel:702-222-1964" class="oz-btn oz-btn-primary">Call Dr. Jan: 702-222-1964</a>
				</div>
				
				<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
					<h3>Henderson Mixed-Use Development</h3>
					<p><strong>Location:</strong> Henderson, NV - Census Tract 28.03</p>
					<p><strong>Investment:</strong> $500K - $2M</p>
					<p><strong>Expected IRR:</strong> 14-18%</p>
					<p><strong>Tax Benefit:</strong> Federal OZ + Nevada tax advantage</p>
					<p><strong>Status:</strong> 60% Funded</p>
					<a href="tel:702-222-1964" class="oz-btn oz-btn-primary">Call Dr. Jan: 702-222-1964</a>
				</div>
				
				<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
					<h3>Summerlin Residential OZ</h3>
					<p><strong>Location:</strong> Summerlin, NV - Census Tract 35.02</p>
					<p><strong>Investment:</strong> $250K - $1M</p>
					<p><strong>Expected IRR:</strong> 12-16%</p>
					<p><strong>Tax Benefit:</strong> Perfect for CA capital gains deferral</p>
					<p><strong>Status:</strong> 40% Funded</p>
					<a href="tel:702-222-1964" class="oz-btn oz-btn-primary">Call Dr. Jan: 702-222-1964</a>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="oz-cta">
		<div class="oz-cta-content">
			<h2>Ready to Optimize Your California Capital Gains?</h2>
			<p>Let Dr. Jan Duffy create your personalized Nevada OZ strategy. 500+ transactions of experience working for you.</p>
			<div class="oz-hero .cta-buttons">
				<a href="tel:702-222-1964" class="oz-btn oz-btn-primary">Call/Text Dr. Jan: 702-222-1964</a>
				<a href="/cross-state-strategies/tax-savings-calculator" class="oz-btn oz-btn-secondary">Calculate Your Savings</a>
			</div>
		</div>
	</section>
</Layout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Dr. Jan Duffy",
  "jobTitle": "Nevada Opportunity Zone Expert",
  "description": "Nevada's premier Opportunity Zone expert with 500+ transactions completed",
  "telephone": "702-222-1964",
  "email": "drjan@boyle-duffy-oz.com",
  "worksFor": {
    "@type": "Organization",
    "name": "Boyle-Duffy West Coast OZ Team"
  },
  "areaServed": {
    "@type": "State",
    "name": "Nevada"
  },
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Real Estate Investment Advisor",
    "occupationLocation": {
      "@type": "City",
      "name": "Las Vegas"
    }
  }
}
</script>

<style>
	.oz-testimonials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}
	
	.oz-testimonial-card {
		background: var(--oz-white);
		padding: 2rem;
		border-radius: 0.5rem;
		box-shadow: var(--oz-shadow);
	}
	
	.testimonial-content {
		margin-bottom: 1.5rem;
	}
	
	.testimonial-content p {
		font-style: italic;
		color: var(--oz-gray-700);
		line-height: 1.6;
	}
	
	.testimonial-author h4 {
		color: var(--oz-navy);
		margin: 0 0 0.25rem 0;
	}
	
	.testimonial-author span {
		color: var(--oz-gray-600);
		font-size: 0.875rem;
		display: block;
		margin: 0.25rem 0;
	}
	
	.oz-hero .cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	
	@media (max-width: 768px) {
		.oz-services-content > div {
			grid-template-columns: 1fr;
		}
	}
</style>
