---
import Layout from '../../layouts/Page.astro';
import Header from '../../components/core/Header.astro';
import Footer from '../../components/core/Footer.astro';
import Logo from '../../components/Logo.astro';
import Button from '../../components/buttons/Button.astro';
import StickyCTA from '../../components/StickyCTA.astro';
import { nav } from '../../config/nav.js';
import settings from '../../config/settings.js';

const seo = {
	...settings,
	title: 'Schedule Your OZ Strategy Consultation | Boyle-Duffy Team',
	description: 'Schedule a consultation with Kelly Boyle (Northern CA), Eugene Boyle (Southern CA), or Dr. Jan Duffy (Nevada) for your cross-state Opportunity Zone investment strategy.',
	canonical: 'https://boyle-duffy-oz.com/contact',
};
---

<Layout seo={seo}>
	<Header rightMenu navData={nav} slot="header">
		<span slot="logo">
			<Logo />
		</span>
		<Button slot="action-item" href="tel:702-222-1964">Call Dr. Jan: 702-222-1964</Button>
	</Header>
	<main class="page-content">
		<section class="hero-section bg-gradient-to-r from-navy-700 to-navy-900 text-white py-20">
			<div class="container mx-auto px-4 text-center">
				<h1 class="text-5xl font-bold mb-4">Schedule Your OZ Strategy Consultation</h1>
				<p class="text-xl mb-8">Connect with the Right Expert for Your Cross-State Opportunity Zone Investment</p>
				<div class="flex justify-center space-x-4">
					<Button href="tel:702-222-1964" variant="primary">Call Dr. Jan: 702-222-1964</Button>
					<Button href="/cross-state-strategies/tax-savings-calculator" variant="secondary">Calculate Your Savings</Button>
				</div>
			</div>
		</section>

		<!-- Expert Selection -->
		<section class="py-16 bg-gray-50">
			<div class="container mx-auto px-4">
				<div class="text-center mb-12">
					<h2 class="text-4xl font-bold text-navy-800 mb-6">Choose Your Expert</h2>
					<p class="text-xl text-gray-700 max-w-3xl mx-auto">
						Each Boyle-Duffy team member specializes in specific markets and client types. Select the expert who best matches your needs and location.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8 mb-12">
					<!-- Kelly Boyle -->
					<div class="bg-white rounded-lg shadow-lg p-8 text-center">
						<div class="w-32 h-32 bg-gray-200 rounded-full mx-auto mb-6 flex items-center justify-center">
							<span class="text-4xl font-bold text-navy-700">KB</span>
						</div>
						<h3 class="text-2xl font-bold text-navy-800 mb-2">Kelly Boyle</h3>
						<p class="text-gold-600 font-semibold mb-4">Northern California Expert</p>
						<div class="text-left mb-6">
							<h4 class="font-semibold text-navy-700 mb-2">Specializes In:</h4>
							<ul class="text-gray-700 space-y-1">
								<li>• Silicon Valley & Bay Area</li>
								<li>• Tech Executives & Startups</li>
								<li>• High-Net-Worth Families</li>
								<li>• Commercial & Multi-Family</li>
							</ul>
						</div>
						<div class="space-y-3">
							<Button href="mailto:kelly@boyle-duffy-oz.com" variant="primary" class="w-full">Email Kelly</Button>
							<Button href="tel:415-555-0123" variant="secondary" class="w-full">Call Kelly</Button>
						</div>
					</div>

					<!-- Eugene Boyle -->
					<div class="bg-white rounded-lg shadow-lg p-8 text-center">
						<div class="w-32 h-32 bg-gray-200 rounded-full mx-auto mb-6 flex items-center justify-center">
							<span class="text-4xl font-bold text-navy-700">EB</span>
						</div>
						<h3 class="text-2xl font-bold text-navy-800 mb-2">Eugene Boyle</h3>
						<p class="text-gold-600 font-semibold mb-4">Southern California Expert</p>
						<div class="text-left mb-6">
							<h4 class="font-semibold text-navy-700 mb-2">Specializes In:</h4>
							<ul class="text-gray-700 space-y-1">
								<li>• Los Angeles & Orange County</li>
								<li>• Entertainment Industry</li>
								<li>• Real Estate Developers</li>
								<li>• Luxury Residential</li>
							</ul>
						</div>
						<div class="space-y-3">
							<Button href="mailto:eugene@boyle-duffy-oz.com" variant="primary" class="w-full">Email Eugene</Button>
							<Button href="tel:310-555-0123" variant="secondary" class="w-full">Call Eugene</Button>
						</div>
					</div>

					<!-- Dr. Jan Duffy -->
					<div class="bg-white rounded-lg shadow-lg p-8 text-center border-2 border-gold-400">
						<div class="w-32 h-32 bg-gray-200 rounded-full mx-auto mb-6 flex items-center justify-center">
							<span class="text-4xl font-bold text-navy-700">JD</span>
						</div>
						<h3 class="text-2xl font-bold text-navy-800 mb-2">Dr. Jan Duffy</h3>
						<p class="text-gold-600 font-semibold mb-4">Nevada & Cross-State Leader</p>
						<div class="text-left mb-6">
							<h4 class="font-semibold text-navy-700 mb-2">Specializes In:</h4>
							<ul class="text-gray-700 space-y-1">
								<li>• Las Vegas & Nevada Markets</li>
								<li>• Cross-State Tax Strategies</li>
								<li>• 500+ Transactions</li>
								<li>• High-Value Deals</li>
							</ul>
						</div>
						<div class="space-y-3">
							<Button href="tel:702-222-1964" variant="primary" class="w-full">Call Dr. Jan: 702-222-1964</Button>
							<Button href="mailto:drjan@boyle-duffy-oz.com" variant="secondary" class="w-full">Email Dr. Jan</Button>
						</div>
						<div class="mt-4 p-3 bg-gold-50 rounded-lg">
							<p class="text-sm text-gold-800 font-semibold">⭐ Recommended for Cross-State Strategies</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Consultation Types -->
		<section class="py-16 bg-white">
			<div class="container mx-auto px-4">
				<div class="text-center mb-12">
					<h2 class="text-4xl font-bold text-navy-800 mb-6">Consultation Options</h2>
					<p class="text-xl text-gray-700 max-w-3xl mx-auto">
						Choose the consultation type that best fits your needs and timeline.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					<!-- Initial Strategy Call -->
					<div class="bg-gray-50 rounded-lg p-8">
						<div class="text-center mb-6">
							<div class="w-16 h-16 bg-navy-700 text-white rounded-full mx-auto mb-4 flex items-center justify-center">
								<span class="text-2xl">📞</span>
							</div>
							<h3 class="text-2xl font-bold text-navy-800 mb-2">Initial Strategy Call</h3>
							<p class="text-gold-600 font-semibold">30 Minutes - Free</p>
						</div>
						<ul class="text-gray-700 space-y-2 mb-6">
							<li>• Assess your capital gains situation</li>
							<li>• Identify OZ opportunities</li>
							<li>• Explain cross-state benefits</li>
							<li>• Determine next steps</li>
						</ul>
						<Button href="tel:702-222-1964" variant="primary" class="w-full">Schedule Now</Button>
					</div>

					<!-- Comprehensive Analysis -->
					<div class="bg-gray-50 rounded-lg p-8 border-2 border-gold-400">
						<div class="text-center mb-6">
							<div class="w-16 h-16 bg-gold-600 text-white rounded-full mx-auto mb-4 flex items-center justify-center">
								<span class="text-2xl">📊</span>
							</div>
							<h3 class="text-2xl font-bold text-navy-800 mb-2">Comprehensive Analysis</h3>
							<p class="text-gold-600 font-semibold">60 Minutes - $500</p>
						</div>
						<ul class="text-gray-700 space-y-2 mb-6">
							<li>• Detailed tax savings calculation</li>
							<li>• Property analysis & recommendations</li>
							<li>• Timeline & requirements review</li>
							<li>• Written strategy document</li>
						</ul>
						<Button href="mailto:drjan@boyle-duffy-oz.com" variant="primary" class="w-full">Schedule Analysis</Button>
					</div>

					<!-- Full Service Package -->
					<div class="bg-gray-50 rounded-lg p-8">
						<div class="text-center mb-6">
							<div class="w-16 h-16 bg-navy-700 text-white rounded-full mx-auto mb-4 flex items-center justify-center">
								<span class="text-2xl">🏆</span>
							</div>
							<h3 class="text-2xl font-bold text-navy-800 mb-2">Full Service Package</h3>
							<p class="text-gold-600 font-semibold">Ongoing - Custom Pricing</p>
						</div>
						<ul class="text-gray-700 space-y-2 mb-6">
							<li>• Complete deal structuring</li>
							<li>• Property sourcing & due diligence</li>
							<li>• Transaction coordination</li>
							<li>• Ongoing portfolio management</li>
						</ul>
						<Button href="tel:702-222-1964" variant="primary" class="w-full">Discuss Package</Button>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Form -->
		<section class="py-16 bg-gray-50">
			<div class="container mx-auto px-4">
				<div class="max-w-2xl mx-auto">
					<div class="text-center mb-8">
						<h2 class="text-4xl font-bold text-navy-800 mb-4">Get Started Today</h2>
						<p class="text-xl text-gray-700">
							Fill out the form below and we'll connect you with the right expert within 24 hours.
						</p>
					</div>

					<form class="bg-white rounded-lg shadow-lg p-8" id="consultation-form">
						<div class="grid md:grid-cols-2 gap-6 mb-6">
							<div>
								<label for="firstName" class="block text-sm font-semibold text-navy-700 mb-2">First Name *</label>
								<input type="text" id="firstName" name="firstName" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
							</div>
							<div>
								<label for="lastName" class="block text-sm font-semibold text-navy-700 mb-2">Last Name *</label>
								<input type="text" id="lastName" name="lastName" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
							</div>
						</div>

						<div class="grid md:grid-cols-2 gap-6 mb-6">
							<div>
								<label for="email" class="block text-sm font-semibold text-navy-700 mb-2">Email *</label>
								<input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
							</div>
							<div>
								<label for="phone" class="block text-sm font-semibold text-navy-700 mb-2">Phone *</label>
								<input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
							</div>
						</div>

						<div class="mb-6">
							<label for="location" class="block text-sm font-semibold text-navy-700 mb-2">Primary Location *</label>
							<select id="location" name="location" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
								<option value="">Select your primary location</option>
								<option value="northern-california">Northern California (Silicon Valley, Bay Area)</option>
								<option value="southern-california">Southern California (Los Angeles, Orange County)</option>
								<option value="nevada">Nevada (Las Vegas, Henderson, Reno)</option>
								<option value="other">Other</option>
							</select>
						</div>

						<div class="mb-6">
							<label for="expert" class="block text-sm font-semibold text-navy-700 mb-2">Preferred Expert</label>
							<select id="expert" name="expert" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
								<option value="">No preference</option>
								<option value="kelly-boyle">Kelly Boyle - Northern California</option>
								<option value="eugene-boyle">Eugene Boyle - Southern California</option>
								<option value="dr-jan-duffy">Dr. Jan Duffy - Nevada & Cross-State</option>
							</select>
						</div>

						<div class="mb-6">
							<label for="capitalGains" class="block text-sm font-semibold text-navy-700 mb-2">Estimated Capital Gains Amount</label>
							<select id="capitalGains" name="capitalGains" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
								<option value="">Select range</option>
								<option value="under-500k">Under $500,000</option>
								<option value="500k-1m">$500,000 - $1,000,000</option>
								<option value="1m-2m">$1,000,000 - $2,000,000</option>
								<option value="2m-5m">$2,000,000 - $5,000,000</option>
								<option value="over-5m">Over $5,000,000</option>
							</select>
						</div>

						<div class="mb-6">
							<label for="timeline" class="block text-sm font-semibold text-navy-700 mb-2">Investment Timeline</label>
							<select id="timeline" name="timeline" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent">
								<option value="">Select timeline</option>
								<option value="immediate">Immediate (within 30 days)</option>
								<option value="3-months">Within 3 months</option>
								<option value="6-months">Within 6 months</option>
								<option value="1-year">Within 1 year</option>
								<option value="planning">Just planning ahead</option>
							</select>
						</div>

						<div class="mb-6">
							<label for="message" class="block text-sm font-semibold text-navy-700 mb-2">Additional Information</label>
							<textarea id="message" name="message" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-500 focus:border-transparent" placeholder="Tell us about your specific situation, goals, or any questions you have..."></textarea>
						</div>

						<div class="mb-6">
							<label class="flex items-center">
								<input type="checkbox" id="privacy" name="privacy" required class="mr-3">
								<span class="text-sm text-gray-700">I agree to the <a href="/privacy-policy" class="text-navy-600 hover:underline">Privacy Policy</a> and consent to being contacted about Opportunity Zone investments.</span>
							</label>
						</div>

						<Button type="submit" variant="primary" class="w-full">Submit Consultation Request</Button>
					</form>
				</div>
			</div>
		</section>

		<!-- Direct Contact -->
		<section class="py-16 bg-navy-700 text-white">
			<div class="container mx-auto px-4 text-center">
				<h2 class="text-4xl font-bold mb-6">Prefer to Talk Directly?</h2>
				<p class="text-xl mb-8">
					For immediate assistance with your Opportunity Zone strategy, call Dr. Jan Duffy directly.
				</p>
				<div class="flex justify-center space-x-4">
					<Button href="tel:702-222-1964" variant="secondary" class="text-2xl px-8 py-4">Call Dr. Jan: 702-222-1964</Button>
				</div>
				<p class="text-lg mt-6 text-gray-300">
					Available Monday-Friday, 8 AM - 6 PM PST
				</p>
			</div>
		</section>
	</main>
	<StickyCTA />
	<Footer />
</Layout>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const form = document.getElementById('consultation-form') as HTMLFormElement;
	if (form) {
		form.addEventListener('submit', function(e) {
			e.preventDefault();
			
			// Get form data
			const formData = new FormData(this);
			const data = Object.fromEntries(formData);
			
			// Basic validation
			if (!data.firstName || !data.lastName || !data.email || !data.phone || !data.location) {
				alert('Please fill in all required fields.');
				return;
			}
			
			// Simulate form submission
			alert('Thank you for your consultation request! We will contact you within 24 hours to schedule your strategy session.');
			
			// Reset form
			this.reset();
		});
	}
});
</script>