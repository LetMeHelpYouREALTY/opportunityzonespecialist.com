---
import Layout from '../layouts/Page.astro';
import '../styles/oz-custom.css';

const seo = {
	title: 'Boyle-Duffy West Coast OZ Team | Cross-State Opportunity Zone Real Estate Experts',
	description: 'The only cross-state OZ real estate experts covering every West Coast wealth center. Kelly Boyle (Northern CA), Eugene Boyle (Southern CA), and Dr. Jan Duffy (Nevada) help high-net-worth clients defer capital gains through strategic cross-state OZ investments.',
};
---

<Layout {seo}>
	<!-- Hero Section -->
	<section class="oz-hero">
		<div class="oz-hero-content">
			<h1>The Only Cross-State OZ Real Estate Experts Covering Every West Coast Wealth Center</h1>
			<p class="subtitle">California capital gains → Nevada OZ investment = Federal OZ benefits + eliminates California state capital gains tax</p>
			<div class="oz-hero-cta">
				<a href="tel:702-222-1964" class="oz-btn oz-btn-primary">Call/Text Dr. Jan: 702-222-1964</a>
				<a href="/cross-state-strategies/tax-savings-calculator" class="oz-btn oz-btn-secondary">Calculate Your Tax Savings</a>
			</div>
		</div>
	</section>

	<!-- Team Introduction -->
	<section class="oz-services">
		<div class="oz-services-content">
			<h2>Meet the Boyle-Duffy West Coast OZ Team</h2>
			<p class="oz-section-subtitle">Three experts, three states, one unified strategy for maximum tax benefits</p>
			
			<div class="oz-services-grid">
				<div class="oz-service-card">
					<div class="expert-photo">👩‍💼</div>
					<h3>Kelly Boyle</h3>
					<h4>Northern California OZ Specialist</h4>
					<p>Bay Area, Silicon Valley, Sacramento</p>
					<ul style="text-align: left; margin-top: 1rem;">
						<li>Tech executive stock option strategies</li>
						<li>Silicon Valley capital gains expertise</li>
						<li>Wine Country OZ investments</li>
						<li>Government district opportunities</li>
					</ul>
					<a href="/kelly-boyle/northern-california" class="oz-btn oz-btn-outline">Kelly's Northern CA Markets</a>
				</div>
				
				<div class="oz-service-card">
					<div class="expert-photo">👨‍💼</div>
					<h3>Eugene Boyle</h3>
					<h4>Southern California OZ Specialist</h4>
					<p>LA, Orange County, San Diego</p>
					<ul style="text-align: left; margin-top: 1rem;">
						<li>Entertainment industry strategies</li>
						<li>Coastal OZ property expertise</li>
						<li>Real estate developer partnerships</li>
						<li>Multi-family development focus</li>
					</ul>
					<a href="/eugene-boyle/southern-california" class="oz-btn oz-btn-outline">Eugene's Southern CA Markets</a>
				</div>
				
				<div class="oz-service-card">
					<div class="expert-photo">👩‍🎓</div>
					<h3>Dr. Jan Duffy</h3>
					<h4>Nevada OZ Expert</h4>
					<p>Las Vegas, Henderson, Reno</p>
					<ul style="text-align: left; margin-top: 1rem;">
						<li>500+ transactions completed</li>
						<li>No state income tax advantage</li>
						<li>Cross-state strategy specialist</li>
						<li>High-net-worth client focus</li>
					</ul>
					<a href="/dr-jan-duffy/las-vegas-oz-properties" class="oz-btn oz-btn-outline">Dr. Jan's Nevada Markets</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Cross-State Strategy Benefits -->
	<section class="oz-authority">
		<div class="oz-authority-content">
			<h2>Why Cross-State OZ Strategies Work</h2>
			<div class="oz-authority-grid">
				<div class="oz-authority-card">
					<h3>🎯 California Capital Gains</h3>
					<p>High-net-worth Californians with significant capital gains from stock sales, real estate, or business exits need immediate tax relief.</p>
				</div>
				<div class="oz-authority-card">
					<h3>🏛️ Federal OZ Benefits</h3>
					<p>Defer capital gains until 2026, reduce by 10-15% with basis step-up, and eliminate taxes on appreciation after 10 years.</p>
				</div>
				<div class="oz-authority-card">
					<h3>💰 Nevada Tax Advantage</h3>
					<p>No state income tax means your California capital gains are completely eliminated when invested in Nevada OZ properties.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Success Stories -->
	<section class="oz-testimonials">
		<div class="oz-testimonials-content">
			<h2>Recent Cross-State Success Stories</h2>
			<div class="oz-testimonials-grid">
				<div class="oz-testimonial-card">
					<div class="testimonial-content">
						<p>"Kelly connected me with Dr. Jan for a Nevada OZ investment that saved me $2.3M in California state taxes on my tech stock gains. The cross-state strategy was brilliant."</p>
					</div>
					<div class="testimonial-author">
						<h4>Sarah Chen</h4>
						<span>Tech Executive, Palo Alto</span>
					</div>
				</div>
				
				<div class="oz-testimonial-card">
					<div class="testimonial-content">
						<p>"Eugene and Dr. Jan worked together to structure my entertainment industry capital gains into a Las Vegas OZ development. The tax savings exceeded our projections."</p>
					</div>
					<div class="testimonial-author">
						<h4>Michael Rodriguez</h4>
						<span>Entertainment Producer, Beverly Hills</span>
					</div>
				</div>
				
				<div class="oz-testimonial-card">
					<div class="testimonial-content">
						<p>"Dr. Jan's Nevada expertise combined with the Boyle brothers' California market knowledge created the perfect cross-state OZ strategy for our family office."</p>
					</div>
					<div class="testimonial-author">
						<h4>Jennifer Walsh</h4>
						<span>Family Office Director, San Francisco</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Current Opportunities -->
	<section class="oz-authority">
		<div class="oz-authority-content">
			<h2>This Week's Featured Cross-State Opportunities</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem;">
				<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
					<h3>Las Vegas Tech Campus OZ</h3>
					<p><strong>Location:</strong> Las Vegas, NV - Census Tract 32.01</p>
					<p><strong>Investment:</strong> $1M - $5M</p>
					<p><strong>Expected IRR:</strong> 16-20%</p>
					<p><strong>Tax Benefit:</strong> Eliminates CA state capital gains tax</p>
					<a href="/dr-jan-duffy/las-vegas-oz-properties" class="oz-btn oz-btn-outline">View Details</a>
				</div>
				
				<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
					<h3>Henderson Mixed-Use Development</h3>
					<p><strong>Location:</strong> Henderson, NV - Census Tract 28.03</p>
					<p><strong>Investment:</strong> $500K - $2M</p>
					<p><strong>Expected IRR:</strong> 14-18%</p>
					<p><strong>Tax Benefit:</strong> Federal OZ + Nevada tax advantage</p>
					<a href="/dr-jan-duffy/henderson-development" class="oz-btn oz-btn-outline">View Details</a>
				</div>
				
				<div style="background: var(--oz-white); padding: 2rem; border-radius: 0.5rem; box-shadow: var(--oz-shadow);">
					<h3>Summerlin Residential OZ</h3>
					<p><strong>Location:</strong> Summerlin, NV - Census Tract 35.02</p>
					<p><strong>Investment:</strong> $250K - $1M</p>
					<p><strong>Expected IRR:</strong> 12-16%</p>
					<p><strong>Tax Benefit:</strong> Perfect for CA capital gains deferral</p>
					<a href="/dr-jan-duffy/summerlin-oz-opportunities" class="oz-btn oz-btn-outline">View Details</a>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="oz-cta">
		<div class="oz-cta-content">
			<h2>Ready to Optimize Your California Capital Gains?</h2>
			<p>Let the Boyle-Duffy team create your personalized cross-state OZ strategy. California expertise meets Nevada tax advantages for maximum benefit.</p>
			<div class="oz-hero .cta-buttons">
				<a href="tel:702-222-1964" class="oz-btn oz-btn-primary">Call/Text Dr. Jan: 702-222-1964</a>
				<a href="/cross-state-strategies/california-nevada-benefits" class="oz-btn oz-btn-secondary">Learn Cross-State Benefits</a>
			</div>
		</div>
	</section>
</Layout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "name": "Boyle-Duffy West Coast OZ Team",
  "description": "Cross-state opportunity zone real estate experts covering California and Nevada",
  "url": "https://boyle-duffy-oz.com",
  "areaServed": [
    {
      "@type": "State",
      "name": "California"
    },
    {
      "@type": "State", 
      "name": "Nevada"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Opportunity Zone Real Estate Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Cross-State OZ Tax Strategy"
        }
      }
    ]
  }
}
</script>

<style>
	.expert-photo {
		width: 4rem;
		height: 4rem;
		background: var(--oz-gold);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1rem;
		font-size: 2rem;
	}
	
	.oz-testimonials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}
	
	.oz-testimonial-card {
		background: var(--oz-white);
		padding: 2rem;
		border-radius: 0.5rem;
		box-shadow: var(--oz-shadow);
	}
	
	.testimonial-content {
		margin-bottom: 1.5rem;
	}
	
	.testimonial-content p {
		font-style: italic;
		color: var(--oz-gray-700);
		line-height: 1.6;
	}
	
	.testimonial-author h4 {
		color: var(--oz-navy);
		margin: 0 0 0.25rem 0;
	}
	
	.testimonial-author span {
		color: var(--oz-gray-600);
		font-size: 0.875rem;
	}
	
	.oz-hero .cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
</style>